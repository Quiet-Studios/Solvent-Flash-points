     ]
    }
   ],
   "source": [
    "#1\n",
    "# Count carbons: letters'C' or 'c' not followed by any lowercase letter to avoid Cl, Ca being counted which was an issue on initial test\n",
    "fp_df[\"n_carbons\"] = fp_df[\"smiles\"].str.count(r'(?:C(?![a-z])|c(?![a-z]))')\n",
    "\n",
    "#2\n",
    "# Count branches: number of \"(\" characters - Was at first unsure if the parenthesis had to include a C to be considered a branch, cleared up by online research indicated below\n",
    "fp_df[\"n_branches\"] = fp_df[\"smiles\"].str.count(r'\\(')\n",
    "\n",
    "#3\n",
    "# My third feature: heteroatom count - Something I thought would affect polarity, intermolecular forces and vapour pressures\n",
    "fp_df[\"n_heteroatoms\"] = fp_df[\"smiles\"].str.count(r'Cl|Br|[NOSPFnospf]')\n",
    "\n",
    "\n",
    "#4\n",
    "# Format for a plot of each of the three correlation graphs - a template.  \n",
    "def plot_corr(feature, label):\n",
    "    x = fp_df[feature]\n",
    "    y = fp_df[\"flashpoint_C\"]\n",
    "\n",
    "    # Linear fit (r denotes the correlation coefficient)\n",
    "    slope, intercept = np.polyfit(x, y, 1)\n",
    "    r = np.corrcoef(x, y)[0, 1]\n",
    "\n",
    "    # Make plot \n",
    "    plt.figure(figsize=(6, 4))\n",
    "    plt.scatter(x, y, edgecolor=\"k\")\n",
    "    xs = np.linspace(x.min(), x.max(), 200)\n",
    "    plt.plot(xs, slope * xs + intercept)\n",
    "    plt.xlabel(label)\n",
    "    plt.ylabel(\"Flash point (°C)\")\n",
    "    plt.title(f\"{label} vs Flash Point\\nr = {r:.3f}\")\n",
    "    plt.grid(True, linestyle=\"--\", alpha=0.4)\n",
    "    plt.show()\n",
    "\n",
    "# Generate the three correlation plots through the 'template'\n",
    "plot_corr(\"n_carbons\", \"Number of carbons\")\n",
    "plot_corr(\"n_branches\", \"Number of branches\")\n",
    "plot_corr(\"n_heteroatoms\", \"Number of heteroatoms\")\n",
    "\n",
    "#5\n",
    "print (\"Discussion: \")\n",
    "print (\"We see that all of the features have a positive correlation with flashpoint, although weakly.\")\n",
    "print (\"As the number of carbons or branches increases the flashpoint increases slowly. \")\n",
    "print (\"The biggest correlation, however, with r = 0.440, is the number of heteroatoms in the molecule.\")\n",
    "print (\"This makes sense as we would expect these atoms to have a larger effect on polarity and vapour pressure. \")\n",
