    "#1\n",
    "# loading data (convertin K to C) and plotting histogram\n",
    "fp_df = pd.read_csv(\"flash_point_data.csv\", delimiter=\",\", header=0)\n",
    "fp_df[\"flashpoint_C\"] = fp_df[\"flashpoint\"] - 273.15\n",
    "\n",
    "plt.hist(fp_df[\"flashpoint_C\"], bins=\"sturges\")\n",
    "plt.xlabel(\"Flash Point (°C)\")\n",
    "plt.ylabel(\"Frequency\")\n",
    "plt.title(\"Histogram of Solvent Flash Points\")\n",
    "plt.grid(alpha=0.3)\n",
    "plt.show()\n",
    "\n",
    "# I used the tool: www.statology.org via google\n",
    "# Prompt: How many bins should I use in my histogram\n",
    "\n",
    "#2\n",
    "#Finding the minimum vaulues for flashpoint\n",
    "min_value = fp_df[\"flashpoint_C\"].min()\n",
    "max_value = fp_df[\"flashpoint_C\"].max()\n",
    "\n",
    "#Assigning these values to a compound, locating them by the flashpoint value - .idx gives us the index row of the min or max values of flashpoint \n",
    "min_compound = fp_df.loc[fp_df[\"flashpoint_C\"].idxmin(), \"compound\"]\n",
    "max_compound = fp_df.loc[fp_df[\"flashpoint_C\"].idxmax(), \"compound\"]\n",
    "\n",
    "print(\"Minimum flash point:\", min_value, \"°C —\", min_compound)\n",
    "print(\"Maximum flash point:\", max_value, \"°C —\", max_compound)\n",
    "\n",
    "#Analysing data - Averages + standard deviation\n",
    "median_value = fp_df[\"flashpoint_C\"].median()\n",
    "print(\"Median flash point:\", median_value, \"°C\")\n",
    "\n",
    "mean_value = fp_df[\"flashpoint_C\"].mean()\n",
    "std_value = fp_df[\"flashpoint_C\"].std()\n",
    "\n",
    "print(\"Mean flash point:\", mean_value, \"°C\")\n",
    "print(\"Standard deviation:\", std_value)\n",
    "\n",
    "# to help me with this question I revisited assessment three, as it had a similar section, and revised the unit 6 and 7 notebooks\n"
