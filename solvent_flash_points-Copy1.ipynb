    "# First I defined the constants\n",
    "R = 8.314462618            # J/mol·K\n",
    "M_air = 0.0289647          # kg/mol\n",
    "g = 9.80665                # m/s²\n",
    "T_atm = 288.15             # K (assumed mean atmospheric temperature)\n",
    "p0_bar = 1.01325           # sea-level pressure (bar)\n",
    "\n",
    "# Height of Ben Nevis\n",
    "h_ft = 4413\n",
    "h_m = h_ft * 0.3048        # height in ft to m \n",
    "\n",
    "# Scale height (isothermal approximation)\n",
    "H = R * T_atm / (M_air * g)\n",
    "\n",
    "# Equation for pressure at altitude( from the paper)\n",
    "p_alt = p0_bar * math.exp(-h_m / H)\n",
    "\n",
    "print(f\"Atmospheric pressure at Ben Nevis summit: {p_alt:.4f} bar\\n\")\n",
    "\n",
    "\n",
    "#Now findint T from 'inverse' antoine equation\n",
    "\n",
    "def boiling_point_from_antoine(A, B, C, pressure_bar):\n",
    "    logP = math.log10(pressure_bar)\n",
    "    T = B / (A - logP) - C   \n",
    "    return T\n",
    "\n",
    "#defining the antoine parameters as found in part 1, in the form compound, (A, B, C) (for below)\n",
    "\n",
    "antoine_params = {\n",
    "    \"Ethane\": (-163.319223, 72410.117757, -627.574179),\n",
    "    \"Benzene\": (-3.603375, 1096.722709, -540.919765),\n",
    "    \"Bromoethane\": (-9.676773, 3123.429587,  -549.742728),\n",
    "    \"Furfural\": (-0.556069, 151.551565, -525.919128 )\n",
    "}\n",
    "\n",
    "\n",
    "#pressure as worked out above\n",
    "print(\"Boiling points at Ben Nevis summit (pressure = {:.4f} bar):\\n\".format(p_alt))\n",
    "\n",
    "#printing results\n",
    "for compound, (A, B, C) in antoine_params.items():\n",
    "    Tb = boiling_point_from_antoine(A, B, C, p_alt)\n",
    "    print(f\"{compound:10s}  →  {Tb:.2f} K\")\n",
    "\n",
    "\n",
    "\n",
    "print(\"\\nASSUMPTIONS:\")\n",
    "print(\"\"\"\n",
    "1. The atmosphere is assumed isothermal at 288 K.\n",
    "   - This allows use of the simplified barometric formula p = p0 * exp(-h/H).\n",
    "\n",
    "2. Sea-level pressure was taken as 1.01325 bar.\n",
    "\n",
    "3. The liquids are assumed pure with ideal vapour behaviour.\n",
    "\n",
    "RELIABILITY:\n",
    " In sea-level pressure:Actual weather variations (±0.02–0.05 bar) will change results.\n",
    "- The altitude pressure calculation is accurate within ~2–5%.\n",
    "The result also relies on the reliability of the antoine fits determined in part 1, which were varying. \n",
    "We would expect then that the BP for ethane below is least reliable and Furfural most reliable( from my previous assessment of the antoine fits.)\n",
    "\"\"\")\n",
