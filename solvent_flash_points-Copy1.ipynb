    "#1. \n",
    "#I imported function from scipy to help with curve fitting and defining the equation (logP is result)\n",
    "\n",
    "vp_df = pd.read_csv(\"vapour_pressures.csv\")\n",
    "\n",
    "T = vp_df[\"T / K\"].values\n",
    "pressure_columns = [col for col in vp_df.columns if col != \"T / K\"]\n",
    "\n",
    "# Antoine equation definition\n",
    "def antoine_eq(T, A, B, C):\n",
    "    return A - B / (C + T)\n",
    "\n",
    "fit_results = {}\n",
    "\n",
    "#I had isues with using just one initial guess, or none, so I defined them below - furfural was ok\n",
    "initial_guesses = {\n",
    "    \"P(ethane) / bar\":     [6.0, 1500.0, 200.0],\n",
    "    \"P(benzene) / bar\":    [-100, 1200.0, 220.0],\n",
    "    \"P(bromoethane)/ bar\":[5.5, 1800.0, 120.0],\n",
    "}\n",
    "\n",
    "# making a loop to extract pressure data and plot it along with a fit \n",
    "for col in pressure_columns:\n",
    "    \n",
    "    #first I am getting the compound name out of the column title\n",
    "    compound_name = col.split(\"(\")[1].split(\")\")[0]\n",
    "    # pressure data\n",
    "    logP = vp_df[col].values\n",
    "    \n",
    "    guess = initial_guesses.get(col)\n",
    "\n",
    "    # curve (finding parameters by equation)\n",
    "    popt, pcov = curve_fit(antoine_eq, T, logP,p0=guess, maxfev=50000)\n",
    "    A, B, C = popt\n",
    "    fit_results[col] = popt\n",
    "\n",
    "    print(f\"\\n=== {compound_name} ===\")\n",
    "    print(f\"A = {A:.6f},   B = {B:.6f},   C = {C:.6f}\")\n",
    "\n",
    "    # making the plot\n",
    "    plt.figure(figsize=(7,5))\n",
    "    plt.scatter(T, logP, label=\"Raw data\", s=20)\n",
    "    plt.plot(T, antoine_eq(T, A, B, C), \"r-\", label=\"Antoine fit\", linewidth=2)\n",
    "    plt.xlabel(\"Temperature (K)\")\n",
    "    plt.ylabel(\"log10 Pressure (bar)\")\n",
    "    plt.title(f\"Antoine Fit for {compound_name}\")\n",
    "    plt.legend()\n",
    "    plt.grid(True)\n",
    "    plt.show()\n",
    "\n",
    "    # Finding the risiduals + the RMSE for analysis \n",
    "    residuals = logP - antoine_eq(T, A, B, C)\n",
    "    rmse = np.sqrt(np.mean(residuals**2))\n",
    "\n",
    "    print(\"Residuals:\", residuals)\n",
    "    print(f\"RMSE = {rmse:.6f}\")\n",
    "\n",
    "# I made a summary table. had to redo the Compound names \n",
    "print(\"===== SUMMARY OF ANTOINE PARAMETERS =====\")\n",
    "for col, params in fit_results.items():\n",
    "    compound_t = col.split(\"(\")[1].split(\")\")[0]\n",
    "    A, B, C = params\n",
    "    print(f\"{compound_t:25s}  A={A:.6f}  B={B:.6f}  C={C:.6f}\")\n",
    "    \n",
    "#analysis of residuals \n",
    "print(\"\\n\\n I found the route mean square error to help asses the quality of the Antoine fits. \")\n",
    "print(\"Ethane: The RMSE was very large, 13.72, suggesting an innacurate curve. As well as this we see along the curve that the residuals are large and positive moving to large and negative and back\")\n",
    "print(\"This suggests a poor fit\")\n",
    "print(\"Benzene: The RMSE was moderate, 0.934, not nearly as large as ethane, suggesting a moree acurate curve. \")\n",
    "print(\"The residuals seem to roam less, so the fit is not as bad\")\n",
    "print(\"Bromoethane: The RMSE was larger, 2.110, suggesting a slightly innacurate curve.\")\n",
    "print(\"The residuals aren't too large, but they go positive to negative and back twice, suggesting lots of movement from the fit, so less accurate\")\n",
    "print(\"Furfural: The RMSE was low, 0.568, suggesting an accurate curve. \")\n",
    "print(\"This is interesting as the residuals move a lot, sporadically where the other plots followed patterns. This means the line does a good job of capturing the average here, a good fit\")\n",
    "\n",
